# Copy to .env.local. Empty credentials keep the demo fully usable.
GEMINI_API_KEY=
GEMINI_MODEL=
# Defaults to preview. Set live only for an explicitly approved demo.
ESCALATION_MODE=preview
GITHUB_TOKEN=
GITHUB_REPOSITORY=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_LABEL=
# Optional local overrides; rules are captured when a new run is created.
SQLITE_PATH=data/triage.sqlite
TRIAGE_HIGH_ATTEMPTS=5
TRIAGE_HIGH_STORES=2
